# Copy to .env and fill in real values. Never commit .env.
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://oweo:oweo@localhost:5433/oweo_dev?schema=public

# 32+ random bytes, base64. Must be two DIFFERENT values.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

APP_BASE_URL=http://localhost:4000

# Comma-separated list of origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000

# console = print the email to the terminal (no account needed).
# resend  = actually send it. Resend's free tier is ~100 emails/day, no card.
#           Until you verify a domain it only delivers to your signup address,
#           and MAIL_FROM must be onboarding@resend.dev.
MAIL_DRIVER=console
MAIL_FROM=Oweo <no-reply@oweo.app>
RESEND_API_KEY=

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
